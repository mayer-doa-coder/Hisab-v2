{
  "name": "hisab-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "type": "module",
  "dependencies": {
    "@expo-google-fonts/anek-bangla": "^0.4.1",
    "@hisab/domain": "*",
    "expo": "^54.0.37",
    "expo-crypto": "~15.0.9",
    "expo-font": "~14.0.12",
    "expo-screen-capture": "~8.0.10",
    "expo-secure-store": "~15.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "@types/sql.js": "^1.4.11",
    "expo-build-properties": "~1.0.10",
    "sql.js": "^1.13.0",
    "typescript": "~5.9.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "pretypecheck": "npm run build --prefix ../../packages/domain",
